# Generated notebooks (kept as jupytext .py source-of-truth)
notebooks/*.ipynb
notebooks/.ipynb_checkpoints/

# MyST / Jupyter Book build output
_build/
public/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/

# Environment / OS
.DS_Store
.env

# Data — never committed; downloaded on first run
data/*
!data/.gitkeep
!data/README.md
# Exception: GBIF citation metadata — small, citation provenance, must be tracked
!data/gbif_bombus_iberia_metadata.json
# Exception: precomputed Iberian HEALPix cell indices — small + deterministic,
# committed so the DestinE download notebook needs no HEALPix library installed
!data/precomputed/
!data/precomputed/**

# Paper PDFs (single PDF allowed; subfolder build artefacts ignored)
paper/_build/
paper/.tmp/

# Figures generated by notebooks (keep curated examples in figures/)
notebooks/figures/

# Reference / external archives
reference/

# Results — large numerical outputs (commit only summary CSVs you reference in figures)
results/raw/
results/logs/
# Tier-1 bambi posterior (~5 MB NetCDF) IS tracked — Tier 2 samples from it.
# results/posterior_bambi.nc

# Docker
docker-image.tar.gz

# Vendored upstream pipeline — outputs are regenerated by `snakemake`
soroye_port/outputs/
soroye_port/outputs_iberia/
soroye_port/phase2_forest.png
soroye_port/phase3_forest.png

# HEALPix-NESTED nside=64 substrate-robustness branch (Phase C) — outputs
# regenerated by `snakemake`. The bambi NetCDF lives under
# results/posterior_bambi_healpix.nc (tracked, like the CEA equivalent).
healpix_port/outputs_iberia/*
!healpix_port/outputs_iberia/.gitkeep

# Snakemake metadata
.snakemake/

# Tier 2 — DestinE Climate DT (licence-locked redistribution)
# Raw NetCDF extracts and per-cell rasters approach a climate fingerprint;
# only the aggregated species-level summary JSON + the figures are committed.
data/destine/
soroye_port/outputs_iberia/*future*
results/projection_per_cell_*.npy

# Claude scratch
.claude/.cache/
.claude/local/
