  "method": {
    "n_posterior_draws": 1000,
    "substrate": "HEALPix-NESTED nside=64 (~92 km cells)",
    "scaling_source": "Tier-1 healpix_port/outputs_iberia/dataGLMM_extinction.parquet z-score constants (mean + ddof=1 SD per raw column; cross-checked against the saved sc_ columns to <= 1e-6)",
    "scaling_constants": {
      "sampling": {
        "mean": 174.52499389648438,
        "sd": 164.0982208251953,
        "max_check_diff": 0.0
      },
      "TEI_bs": {
        "mean": 0.44926929473876953,
        "sd": 0.05676843225955963,
        "max_check_diff": 0.0
      },
      "TEI_delta": {
